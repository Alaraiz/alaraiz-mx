# ─── Turso / LibSQL ───────────────────────────────────────────────
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=your-auth-token

# ─── Auth ─────────────────────────────────────────────────────────
# Secret for signing JWT tokens (generate with: openssl rand -base64 32)
AUTH_SECRET=replace-with-a-random-secret

# Optional seed credentials. Required only when creating missing users locally.
SEED_ADMIN_EMAIL=Alaraiz@pm.me
SEED_ADMIN_PASSWORD=
SEED_EDITOR_EMAIL=
SEED_EDITOR_PASSWORD=

# ─── App ──────────────────────────────────────────────────────────
NEXT_PUBLIC_SITE_URL=https://alaraiz.mx

# ─── Vercel Blob (media uploads) ──────────────────────────────────
# Créalo en Vercel dashboard > Storage > Blob, pega aquí y en las env vars del proyecto Vercel
BLOB_READ_WRITE_TOKEN=

# ─── Pasarela de pago ────────────────────────────────────────────
# Proveedor activo: 'manual' | 'clip' | 'stripe' | 'mercadopago'
# Default: 'manual' (simula checkout sin cobro real — útil para desarrollo)
PAYMENT_PROVIDER=manual

# Clip Checkout Transparente (si PAYMENT_PROVIDER=clip)
# NEXT_PUBLIC_CLIP_API_KEY inicializa el SDK/iframe de tarjeta en el navegador.
# CLIP_API_KEY se usa solo en backend para llamar POST https://api.payclip.com/payments.
NEXT_PUBLIC_PAYMENT_PROVIDER=manual
NEXT_PUBLIC_CLIP_API_KEY=
CLIP_API_KEY=
# La doc de Clip menciona Bearer para SDK + Payments; si tu cuenta requiere Basic, cambia esto a Basic.
CLIP_AUTH_SCHEME=Bearer

# Stripe (solo si PAYMENT_PROVIDER=stripe)
STRIPE_SECRET_KEY=sk_test_...

# MercadoPago (solo si PAYMENT_PROVIDER=mercadopago)
MERCADOPAGO_TOKEN=APP_USR-...

# Secret para verificar webhooks de la pasarela (Stripe: whsec_..., MP: custom)
PAYMENT_WEBHOOK_SECRET=your-webhook-secret
